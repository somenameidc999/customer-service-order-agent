# Copy to .env and fill in the Shopify app credentials. Never commit real values.
SHOPIFY_STORE_DOMAIN=nate-ce.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SCOPES=read_orders,write_orders,read_customers,read_products
SHOPIFY_API_VERSION=2026-10
# Optional: a pre-provisioned Admin API token. Normally acquired at runtime.
# SHOPIFY_ACCESS_TOKEN=
