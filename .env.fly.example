# Copy to .env.fly. Keep real values out of Git and the Docker build.
# The browser login uses DEMO_USERNAME from fly.toml (default: demo).
DEMO_PASSWORD=
OPENROUTER_API_KEY=

# Use credentials for a dedicated Shopify demo store with synthetic customer data.
# The connector currently requires both client credentials even with an access token.
SHOPIFY_STORE_DOMAIN=your-demo-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SCOPES=read_orders,write_orders,read_customers,read_products
SHOPIFY_API_VERSION=2026-10
# SHOPIFY_ACCESS_TOKEN=
# OPENROUTER_MODEL=openai/gpt-4o-mini
